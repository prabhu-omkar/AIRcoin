# AIRcoin digital twin. Copy to .env.local, or pass the same keys as URL parameters.
VITE_SOURCE=live                    # live (MQTT + chain) | mock
VITE_MINER_ID=miner-001
VITE_MQTT_WS=ws://localhost:9001    # Mosquitto WebSocket listener
VITE_C4_URL=http://localhost:8700   # any aircoind node's gateway
VITE_MARKET_URL=http://localhost:3000/
# VITE_FEED_URL=http://pi.local:8080/   # camera streams from the vision pipeline

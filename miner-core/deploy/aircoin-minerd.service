[Unit]
Description=AIRcoin miner daemon
After=network-online.target mosquitto.service gpsd.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/aircoin/miner-core
EnvironmentFile=-/opt/aircoin/miner-core/.env
ExecStart=/opt/aircoin/venv/bin/python -m minerd daemon
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

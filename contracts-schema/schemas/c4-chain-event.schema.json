{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircoin.example/schemas/v1/c4-chain-event.schema.json",
  "title": "C4 · Live chain event (C -> A and apps)",
  "description": "One message on the indexer WebSocket (ws(s)://<host>/v1/events, optional ?miner_id=... or ?address=... filter). Sent once the transaction is mined; the indexer de-duplicates by (tx_hash, log_index).",
  "type": "object",
  "required": ["v", "type", "tx_hash", "log_index", "block_number", "ts", "data"],
  "properties": {
    "v": { "$ref": "common.schema.json#/$defs/schema_version" },
    "type": { "type": "string", "enum": ["mint", "transfer", "trade", "burn"] },
    "tx_hash": { "$ref": "common.schema.json#/$defs/tx_hash" },
    "log_index": { "type": "integer", "minimum": 0 },
    "block_number": { "type": "integer", "minimum": 0 },
    "ts": { "$ref": "common.schema.json#/$defs/timestamp_ms" },
    "explorer_url": { "type": "string", "format": "uri" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "mint" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/mint" } } }
    },
    {
      "if": { "properties": { "type": { "const": "transfer" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/transfer" } } }
    },
    {
      "if": { "properties": { "type": { "const": "trade" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/trade" } } }
    },
    {
      "if": { "properties": { "type": { "const": "burn" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/burn" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "mint": {
      "description": "MintController minted AIR for one miner epoch.",
      "type": "object",
      "required": ["miner_id", "epoch", "to", "amount", "evidence_hash"],
      "properties": {
        "miner_id": { "$ref": "common.schema.json#/$defs/miner_id" },
        "epoch": { "$ref": "common.schema.json#/$defs/epoch" },
        "to": { "$ref": "common.schema.json#/$defs/eth_address" },
        "amount": { "$ref": "common.schema.json#/$defs/token_amount" },
        "evidence_hash": { "$ref": "common.schema.json#/$defs/bytes32_hex" }
      },
      "additionalProperties": false
    },
    "transfer": {
      "description": "Plain AIR ERC-20 transfer between wallets (not mint, burn or marketplace escrow).",
      "type": "object",
      "required": ["token", "from", "to", "amount"],
      "properties": {
        "token": { "type": "string", "enum": ["AIR", "tINR"] },
        "from": { "$ref": "common.schema.json#/$defs/eth_address" },
        "to": { "$ref": "common.schema.json#/$defs/eth_address" },
        "amount": { "$ref": "common.schema.json#/$defs/token_amount" }
      },
      "additionalProperties": false
    },
    "trade": {
      "description": "Marketplace listing bought. price_tinr is the total paid for amount_air.",
      "type": "object",
      "required": ["listing_id", "seller", "buyer", "amount_air", "price_tinr"],
      "properties": {
        "listing_id": { "type": "integer", "minimum": 0 },
        "seller": { "$ref": "common.schema.json#/$defs/eth_address" },
        "buyer": { "$ref": "common.schema.json#/$defs/eth_address" },
        "amount_air": { "$ref": "common.schema.json#/$defs/token_amount" },
        "price_tinr": { "$ref": "common.schema.json#/$defs/token_amount" }
      },
      "additionalProperties": false
    },
    "burn": {
      "description": "ComplianceRegistry.burnForCompliance: AIR burned against a company's obligation for a period.",
      "type": "object",
      "required": ["company", "period", "amount", "obligation", "burned_to_date"],
      "properties": {
        "company": { "$ref": "common.schema.json#/$defs/eth_address" },
        "company_name": { "type": "string" },
        "period": {
          "description": "Compliance period label, e.g. '2026' or '2026-Q4'.",
          "type": "string"
        },
        "amount": { "$ref": "common.schema.json#/$defs/token_amount" },
        "obligation": { "$ref": "common.schema.json#/$defs/token_amount" },
        "burned_to_date": { "$ref": "common.schema.json#/$defs/token_amount" }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircoin.example/schemas/v1/c4-chain-api.schema.json",
  "title": "C4 · Chain REST API responses (C -> A and apps)",
  "description": "Response bodies of the indexer's REST API. Each route's body is one of the $defs below:\n  GET /v1/miners/{miner_id}          -> miner\n  GET /v1/miners/{miner_id}/balance  -> balance (the miner owner's wallet)\n  GET /v1/miners/{miner_id}/mints    -> mint_list (query: ?limit=50&before_epoch=N)\n  any non-2xx                        -> error",
  "$defs": {
    "miner": {
      "type": "object",
      "required": ["v", "miner_id", "device_address", "owner_wallet", "sticker_ids", "status", "location", "totals"],
      "properties": {
        "v": { "$ref": "common.schema.json#/$defs/schema_version" },
        "miner_id": { "$ref": "common.schema.json#/$defs/miner_id" },
        "device_address": { "$ref": "common.schema.json#/$defs/eth_address" },
        "owner_wallet": { "$ref": "common.schema.json#/$defs/eth_address" },
        "sticker_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/tag_id" },
          "maxItems": 20,
          "uniqueItems": true
        },
        "sticker_set_hash": { "$ref": "common.schema.json#/$defs/bytes32_hex" },
        "status": { "$ref": "registry.schema.json#/$defs/miner_status" },
        "location": { "$ref": "registry.schema.json#/$defs/location" },
        "registered_at": { "$ref": "common.schema.json#/$defs/timestamp_ms" },
        "totals": {
          "type": "object",
          "required": ["minted", "epochs_minted", "epochs_rejected"],
          "properties": {
            "minted": { "$ref": "common.schema.json#/$defs/token_amount" },
            "epochs_minted": { "type": "integer", "minimum": 0 },
            "epochs_rejected": { "type": "integer", "minimum": 0 },
            "last_mint_epoch": { "$ref": "common.schema.json#/$defs/epoch" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "balance": {
      "type": "object",
      "required": ["v", "miner_id", "address", "air", "tinr", "block_number"],
      "properties": {
        "v": { "$ref": "common.schema.json#/$defs/schema_version" },
        "miner_id": { "$ref": "common.schema.json#/$defs/miner_id" },
        "address": { "$ref": "common.schema.json#/$defs/eth_address" },
        "air": { "$ref": "common.schema.json#/$defs/token_amount" },
        "tinr": { "$ref": "common.schema.json#/$defs/token_amount" },
        "block_number": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "mint": {
      "type": "object",
      "required": ["miner_id", "epoch", "amount", "to", "evidence_hash", "tx_hash", "block_number", "ts"],
      "properties": {
        "miner_id": { "$ref": "common.schema.json#/$defs/miner_id" },
        "epoch": { "$ref": "common.schema.json#/$defs/epoch" },
        "amount": { "$ref": "common.schema.json#/$defs/token_amount" },
        "to": { "$ref": "common.schema.json#/$defs/eth_address" },
        "evidence_hash": { "$ref": "common.schema.json#/$defs/bytes32_hex" },
        "tx_hash": { "$ref": "common.schema.json#/$defs/tx_hash" },
        "block_number": { "type": "integer", "minimum": 0 },
        "ts": { "$ref": "common.schema.json#/$defs/timestamp_ms" }
      },
      "additionalProperties": false
    },
    "mint_list": {
      "type": "object",
      "required": ["v", "miner_id", "items"],
      "properties": {
        "v": { "$ref": "common.schema.json#/$defs/schema_version" },
        "miner_id": { "$ref": "common.schema.json#/$defs/miner_id" },
        "items": {
          "description": "Newest first.",
          "type": "array",
          "items": { "$ref": "#/$defs/mint" }
        },
        "next_before_epoch": {
          "description": "Pass as before_epoch to fetch the next page; absent on the last page.",
          "$ref": "common.schema.json#/$defs/epoch"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "examples": ["miner_not_found", "bad_request", "internal"] },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}

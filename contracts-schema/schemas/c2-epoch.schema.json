{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircoin.example/schemas/v1/c2-epoch.schema.json",
  "title": "C2 · Epoch summary (B -> A, C)",
  "description": "Published by miner-core on MQTT topic miner/{miner_id}/epoch (QoS 1, retained) when an epoch closes, and re-published for the same epoch whenever its attestation status changes (pending -> submitted -> accepted/rejected).",
  "type": "object",
  "required": ["v", "miner_id", "epoch", "start_ms", "end_ms", "plants", "by_pollutant_mg", "total_air", "attestation", "flags"],
  "properties": {
    "v": { "$ref": "common.schema.json#/$defs/schema_version" },
    "miner_id": { "$ref": "common.schema.json#/$defs/miner_id" },
    "epoch": { "$ref": "common.schema.json#/$defs/epoch" },
    "start_ms": { "$ref": "common.schema.json#/$defs/timestamp_ms" },
    "end_ms": { "$ref": "common.schema.json#/$defs/timestamp_ms" },
    "scenario": { "type": "string" },
    "sensor_summary": { "$ref": "common.schema.json#/$defs/sensor_summary" },
    "plants": {
      "description": "Per-plant estimate for the epoch (PRD 2.5 model R_i,p).",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["tag_id", "species", "status", "removed_mg", "air"],
        "properties": {
          "tag_id": { "$ref": "common.schema.json#/$defs/tag_id" },
          "species": { "$ref": "common.schema.json#/$defs/species_id_or_unknown" },
          "status": { "$ref": "common.schema.json#/$defs/plant_status" },
          "leaf_area_cm2": { "type": "number", "minimum": 0 },
          "health": { "type": "number", "minimum": 0, "maximum": 1 },
          "removed_mg": { "$ref": "common.schema.json#/$defs/per_pollutant_mg" },
          "air": {
            "description": "Weighted AIR for this plant this epoch (sum_p w_p * R_i,p).",
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "by_pollutant_mg": {
      "description": "Total removed per pollutant across all plants (drives the per-pollutant breakdown on stage).",
      "$ref": "common.schema.json#/$defs/per_pollutant_mg"
    },
    "total_air": {
      "description": "Epoch total in AIR (decimal, display). The attestation's amount is the authoritative base-unit value.",
      "type": "number",
      "minimum": 0
    },
    "attestation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "common.schema.json#/$defs/attestation_status" },
        "evidence_hash": { "$ref": "common.schema.json#/$defs/bytes32_hex" },
        "amount": { "$ref": "common.schema.json#/$defs/token_amount" },
        "tx_hash": { "$ref": "common.schema.json#/$defs/tx_hash" },
        "reason_code": { "$ref": "common.schema.json#/$defs/rejection_reason_code" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "flags": {
      "description": "Anti-cheat flags raised during this epoch.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/anticheat_flag" }
    }
  },
  "additionalProperties": false
}
